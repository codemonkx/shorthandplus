# =====================================================================
# Shorthand Plus — Production Environment Configuration
# =====================================================================

# Server Port
PORT=5000

# Security: JWT Token Signing Secret (replace with 64-char secret in production)
JWT_SECRET=shorthand_plus_production_jwt_secret_key_2026_super_secure

# Admin Director Security PIN
ADMIN_PIN=8080

# ---------------------------------------------------------------------
# PostgreSQL Database Configuration
# ---------------------------------------------------------------------
# Standard connection string format:
# postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
#
# Examples:
# 1. Local PostgreSQL:
#    DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shorthandplus
# 2. Supabase:
#    DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# 3. Neon Serverless Postgres:
#    DATABASE_URL=postgresql://user:password@ep-cool-fog-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
# 4. Render / Railway:
#    DATABASE_URL=postgresql://postgres:password@monorail.proxy.rlwy.net:12345/railway
#
# Note: If DATABASE_URL is left blank, the server automatically uses the high-performance
# embedded SQLite engine with WAL mode at server/data/shorthand.db for seamless offline development.
DATABASE_URL=

# ---------------------------------------------------------------------
# Razorpay Payment Gateway Credentials
# ---------------------------------------------------------------------
# Get keys from Razorpay Dashboard (Settings -> API Keys)
# Test keys begin with: rzp_test_...
# Live keys begin with: rzp_live_...
RAZORPAY_KEY_ID=rzp_test_shorthandplus
RAZORPAY_KEY_SECRET=shorthand_razorpay_secret_key_2026
RAZORPAY_WEBHOOK_SECRET=shorthand_webhook_secret_2026

# ---------------------------------------------------------------------
# Outbound Email (SMTP) Configuration
# ---------------------------------------------------------------------
# Used to send password reset OTPs and notifications to student inboxes.
#
# Option A: Gmail SMTP (Simplest for testing & production)
# 1. Google Account -> Security -> Enable 2-Step Verification
# 2. Go to "App passwords" -> Generate an App Password (16 characters)
# 3. Configure:
#    SMTP_HOST=smtp.gmail.com
#    SMTP_PORT=465
#    SMTP_SECURE=true
#    SMTP_USER=your_email@gmail.com
#    SMTP_PASS=xxxx xxxx xxxx xxxx
#    SMTP_FROM="Gaya Shorthand Classes" <your_email@gmail.com>
#
# Option B: Brevo (Sendinblue) / SendGrid / AWS SES / Custom Webmail:
#    SMTP_HOST=smtp-relay.brevo.com
#    SMTP_PORT=587
#    SMTP_SECURE=false
#    SMTP_USER=your_login
#    SMTP_PASS=your_api_key
#    SMTP_FROM="Gaya Shorthand Classes" <notifications@yourdomain.com>
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
